# ==============================================================================
# SentinelX Enterprise Intelligence Operating System - Environment Variables Example
# ==============================================================================

# -----------------
# Core Server Configuration
# -----------------
PORT=3000
NODE_ENV=development # Options: development, production

# -----------------
# Cognitive & AI Analytics
# -----------------
# Provide your Gemini API key from Google AI Studio to enable live cognitive threat forensics.
# If omitted, SentinelX will operate gracefully in offline deterministic reasoning mode.
GEMINI_API_KEY=""

# -----------------
# Data Fabric Storage (Database)
# -----------------
# In-memory / local fallback starts automatically via SQL.JS/SQLite if this is blank.
# For production docker execution, use: postgres://postgres:postgres_pass@postgres-db:5432/sentinelx_enterprise
DATABASE_URL=""
DB_POOL_MAX=15

# -----------------
# High-Throughput Event Mesh (Redis)
# -----------------
# SentinelX automatically falls back to an in-memory Pub/Sub event router if REDIS_URL is blank.
# For production docker execution, use: redis://:sentinel_redis_secret@redis-stream:6379/0
REDIS_URL=""

# -----------------
# Threat Intelligence Integration
# -----------------
# Keys for live external context enrichment (optional)
VIRUSTOTAL_API_KEY=""
SHODAN_API_KEY=""

# -----------------
# Cloud Observability & Connectors (Optional)
# -----------------
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_DEFAULT_REGION="us-east-1"
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
